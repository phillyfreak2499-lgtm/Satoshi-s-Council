# Satoshi's Council — copy to .env for local runs. Never commit the real .env.
# On Render these go in the dashboard as secret env vars (or /etc/secrets files).

# ── Secrets ───────────────────────────────────────────────────────────
# Gates Settings writes, brain export/import, seat backfill, Excel export,
# forced analyze/huddle, live arming, and Follower lock 1.
# Unset = those routes stay closed. Reads and the Round Table still work.
# Rotate this value on Render after any client leak. Never put it in JS.
COUNCIL_ADMIN_PASSWORD=

# Shared desk gate (POST /api/desk/unlock). Unset = fails closed.
COUNCIL_ACCESS_PASSWORD=

# Follower locks 2 and 3. Lock 1 is COUNCIL_ADMIN_PASSWORD above.
FOLLOWER_PASSWORD_2=
FOLLOWER_PASSWORD_3=

# Funding / OI / liquidation feeds. Unset = Binance USDT-M public perps fallback
# (CARRY / CHAIN / CASCADE stay live). Keyed CoinGlass still preferred when it answers.
COINGLASS_API_KEY=

# ── Storage ───────────────────────────────────────────────────────────
DATA_DIR=./data

# ── HTTP ──────────────────────────────────────────────────────────────
# "*" disables credentialed cross-origin calls. Set an explicit origin list
# (comma-separated) if you need cookies to work cross-origin.
CORS_ORIGINS=*

# Set to 0 only when serving over plain http on localhost.
FOLLOWER_COOKIE_SECURE=1

# ── Live order routing — off unless you mean it ───────────────────────
# Even with these on, arming requires the admin password.
SIDE_TABLE_LIVE=0
FRONT_LIVE=0

# ── Council → engine gate ─────────────────────────────────────────────
# Whether the Round Table's discipline holds back the trade engine.
#   off  = advisory only; council decision recorded, trades unchanged (default)
#   hard = on a council stand-down (no confluence), force WAIT and drop NEW
#          directional path legs (existing legs still cut/flip)
# Run "off" first, confirm the council's confluence windows outperform, then
# switch to "hard".
COUNCIL_GATE_MODE=off

# ── Membership billing (optional; endpoints fail closed if unset) ──
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...            # recurring $24/mo price
# STRIPE_SUCCESS_URL=https://your.app/workspace?member=1&session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=https://your.app/workspace
# Free personal-journal cap (membership unlocks full history)
FREE_JOURNAL_LIMIT=10
