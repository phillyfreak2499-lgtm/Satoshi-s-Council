{
  "name": "Satoshi's Council",
  "install": "pip install --user -r requirements.txt",
  "terminals": [
    {
      "name": "backend",
      "command": "PYTHONPATH=. python3 -m uvicorn backend.main:app --host 0.0.0.0 --port 8000 --workers 1"
